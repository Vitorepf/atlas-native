<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>pt-BR</string>
	<key>CFBundleDisplayName</key>
	<string>Atlas</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIAppFonts</key>
	<array>
		<string>Fraunces_400Regular.ttf</string>
		<string>Fraunces_400Regular_Italic.ttf</string>
		<string>Fraunces_500Medium.ttf</string>
		<string>Fraunces_600SemiBold.ttf</string>
		<string>Fraunces_700Bold.ttf</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Config de backend (do Config.xcconfig / Secrets.xcconfig), lido em AtlasSession -->
	<key>ATLAS_HOST</key>
	<string>$(ATLAS_HOST)</string>
	<key>ATLAS_PORT</key>
	<string>$(ATLAS_PORT)</string>
	<key>ATLAS_TOKEN</key>
	<string>$(ATLAS_TOKEN)</string>
	<!-- Dev: permite HTTP pro atlas-server local (127.0.0.1 no simulador, IP da LAN no device) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Atlas conecta ao servidor local no seu Mac.</string>
</dict>
</plist>
