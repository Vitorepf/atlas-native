// Copie para `Secrets.xcconfig` (gitignored) e preencha. O app lê estes valores
// via Info.plist em AtlasSession.
//
//   cp Secrets.example.xcconfig Secrets.xcconfig
//
// Token: pegue o ATLAS_TOKEN do atlas-server/.env.
// Device real: troque ATLAS_HOST pelo IP da LAN do Mac (ex: 192.168.0.42),
// senão o iPhone não acha 127.0.0.1.

ATLAS_TOKEN = cole-o-ATLAS_TOKEN-aqui
// ATLAS_HOST = 192.168.0.42
