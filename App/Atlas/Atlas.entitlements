<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs é exigido para os tokens ActivityKit remotos. O valor vem do
	     build configuration, nunca de um segredo do app. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- App Group (snapshot dos widgets, M118) REMOVIDO do build até ser
	     provisionado no Apple Developer portal. O writer/reader do snapshot
	     é fail-open: sem o grupo, os widgets mostram "abra o Atlas". -->
</dict>
</plist>
